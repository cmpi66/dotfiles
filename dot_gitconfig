[pull]
	rebase = true
[rebase]
	autoStash = true
[fetch]
	prune = true
[push]
	default = simple
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
[alias]
	sync = "!f() { git add -A && { git diff --cached --quiet || git commit -m \"${1:-sync}\"; } && git pull && git push; }; f"
