#!/usr/bin/env bash

STORMDIR="$HOME/.config/themes/catppuccin-night/"

kitty_conf() {
  cp "$STORMDIR/kitty.conf" "$HOME/.config/kitty"
}

kitty_conf

btop_conf() {
  cp "$STORMDIR/btop.conf" "$HOME/.config/btop" && pkill -SIGUSR2 btop
}

btop_conf

rofi_config() {
  cp "$STORMDIR/config.rasi" "$HOME/.config/rofi/config.rasi"
}

rofi_config

# zsh config, this also has fzf and bat exports

zsh_config() {
  cp "$STORMDIR/.zshrc" "$HOME/.config/zsh/"
}

zsh_config

niri_config() {
  cp "$STORMDIR/config.kdl" "$HOME/.config/niri" && niri msg action load-config-file >/dev/null 2>&1
}

niri_config

# tmux alsways struggles to load at times, figure out a better way to live reload
tmux_conf() {
  cp "$STORMDIR/tmux.conf" "$HOME/.config/tmux/" && tmux source-file ~/.config/tmux/tmux.conf >/dev/null
}

tmux_conf

neovim_conf() {
  cp "$STORMDIR/colorscheme.lua" "$HOME/.config/nvim/lua/plugins"
}

neovim_conf

scim_conf() {
  cp "$STORMDIR/scimrc" "$HOME/.config/sc-im/"
}

scim_conf

starship_conf() {
  cp "$STORMDIR/starship.toml" "$HOME/.config/"
}

starship_conf

aerc_conf() {
  cp "$STORMDIR/aerc.conf" "$HOME/.config/aerc/"
}

aerc_conf

# primitive lazy reload conf for now, not checking for running instance
qutbrowser_conf() {
  cp "$STORMDIR/qutebrowser/config.py" "$HOME/.config/qutebrowser/" && qutebrowser ':config-source '
}

qutbrowser_conf

stupidweb_conf() {
  cp "$STORMDIR/stupid-web/config.py" "$HOME/.config/stupid-web/" && qutebrowser --basedir ~/.config/stupid-web/ ':config-source ~/.config/stupid-web/config.py'
}

stupidweb_conf

noctalia msg theme-mode-set dark
